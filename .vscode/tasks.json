    {
      "type": "shell",
      "label": "build hello_world with env",
      "command": "env -i TERM=xterm-256color SHELL=/bin/bash LANG=en_US.UTF-8 HOME=/home/radxa LD_LIBRARY_PATH=/home/radxa/gcc/install/lib64 PATH=/usr/local/bin:/usr/bin:/bin:/home/radxa/gcc/install/bin bazel build --compilation_mode=dbg --jobs=6  --define MEDIAPIPE_DISABLE_GPU=1 mediapipe/examples/desktop/hello_world:hello_world",
      "problemMatcher": [],
      "options": {
