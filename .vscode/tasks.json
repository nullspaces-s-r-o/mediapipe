      "problemMatcher": [],
      "options": {
        "env": {
          "LD_LIBRARY_PATH": "$HOME/gcc/install/lib64",
          "LANG": "en_US.UTF-8",
          "PATH": "/usr/local/bin:/usr/bin:/bin"
        }
      }
    },
    {
      "type": "shell",
      "label": "build hand_tracking_tpu",
      "command": "env -i TERM=xterm-256color SHELL=/bin/bash LANG=en_US.UTF-8 HOME=/home/radxa LD_LIBRARY_PATH=/home/radxa/gcc/install/lib64 PATH=/usr/local/bin:/usr/bin bazel build --compilation_mode=dbg --jobs=6 --copt=-DLIBYUV_DISABLE_NEON --define MEDIAPIPE_DISABLE_GPU=1 --define MEDIAPIPE_EDGE_TPU=usb --linkopt=-l:libusb-1.0.so --define darwinn_portable=1 mediapipe/examples/coral:hand_tracking_tpu",
      "problemMatcher": [],
      "options": {
        "env": {
          "LD_LIBRARY_PATH": "$HOME/gcc/install/lib64",
          "LANG": "en_US.UTF-8",
          "PATH": "/usr/local/bin:/usr/bin:/bin"
        }
      }
    },
    {
      "type": "shell",
      "label": "build hand_tracking_tpu_client",
      "command": "env -i TERM=xterm-256color SHELL=/bin/bash LANG=en_US.UTF-8 HOME=/home/radxa LD_LIBRARY_PATH=/home/radxa/gcc/install/lib64 PATH=/usr/local/bin:/usr/bin bazel build --compilation_mode=opt --jobs=4 --copt=-DLIBYUV_DISABLE_NEON --define MEDIAPIPE_DISABLE_GPU=1 --define MEDIAPIPE_EDGE_TPU=pci --linkopt=-l:libusb-1.0.so --define darwinn_portable=1 mediapipe/examples/coral:hand_tracking_tpu_client",
      "problemMatcher": [],
      "options": {
        "env": {
